# ───────────────────────────────────────────────────────────────────
# RESUMETAILOR — environment variables
# Copy this file to .env.local and fill in real values.
# Anything beginning with VITE_ is shipped to the browser bundle.
# Everything else is server-side only and must NEVER be exposed.
# ───────────────────────────────────────────────────────────────────


# ─── CLIENT-SIDE (safe in the browser) ────────────────────────────

# Your Supabase project URL.
# Where: Supabase Dashboard → Project Settings (gear) → API → "Project URL".
# Safe to expose? Yes — it's a public URL.
# Read by: src/lib/supabase.ts
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon (public) key.
# Where: Supabase Dashboard → Project Settings → API → "anon public".
# Safe to expose? Yes — Row Level Security in the database protects the data,
# not this key. Anyone with the URL + anon key can only do what RLS allows.
# Read by: src/lib/supabase.ts
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# Public base URL of the app — your deployed URL in production, or
# http://localhost:8080 for local dev. Used to build the redirect URL
# in password reset emails so the user lands on /auth/reset-password.
# Safe to expose? Yes — it's the public URL of your own app.
# Read by: src/pages/auth/ForgotPassword.tsx
VITE_APP_URL=http://localhost:8080


# ─── SERVER-SIDE (Edge Functions only — never commit, never expose) ───
# In production these live in Supabase → Project Settings → Edge
# Functions → Secrets. They are duplicated in .env.local only so you
# can run edge functions locally with the Supabase CLI.

# Same URL as VITE_SUPABASE_URL, but without the VITE_ prefix so it can
# be read inside Deno edge functions.
# Where: identical to VITE_SUPABASE_URL.
# Safe to expose? Yes (same URL, just a different consumer).
# Read by: supabase/functions/_shared/admin.ts, supabase/functions/_shared/client.ts
SUPABASE_URL=https://your-project-ref.supabase.co

# Same value as VITE_SUPABASE_ANON_KEY but without the VITE_ prefix —
# read by edge functions via Deno.env.get to build the user-JWT-scoped
# Supabase client. The anon key is safe to expose; this duplicate exists
# only so the same value is reachable from both the browser bundle and
# the Deno edge runtime.
# Where: identical to VITE_SUPABASE_ANON_KEY.
# Safe to expose? Yes (same key as the VITE_ version).
# Read by: supabase/functions/_shared/client.ts
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# Supabase service role key — BYPASSES ALL ROW LEVEL SECURITY.
# Where: Supabase Dashboard → Project Settings → API → "service_role" (Reveal).
# Safe to expose? NO. If this leaks, anyone can read or wipe any user's data.
# Used only for: the signup trigger, parse-upload reading from Storage,
# and anonymous support-message / waitlist-signup inserts.
# Read by: supabase/functions/_shared/admin.ts (service-role-only client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# Groq API key — primary AI provider (Llama 3.3 70B + 3.1 8B).
# Where: https://console.groq.com → API Keys → Create API Key.
# Safe to expose? NO. Server-side only.
# Read by: supabase/functions/_shared/llama.ts
GROQ_API_KEY=gsk_...

# Together AI API key — fallback provider when Groq 429s.
# Where: https://api.together.xyz/settings/api-keys
# Safe to expose? NO. Server-side only.
# Optional for v1: leave blank and the adapter will surface a polite
# "ai_unavailable" error to the client when Groq is saturated.
# Read by: supabase/functions/_shared/llama.ts
TOGETHER_API_KEY=


# ─── TEST FLAGS (CI only) ─────────────────────────────────────────

# Truthfulness test gate. When 1, Vitest runs a fixture-based test that
# calls the real Llama tailoring prompt and asserts the output does not
# introduce new proper nouns or numbers vs. the input. Default 0 so
# local test runs and PR checks don't burn the Groq free tier.
# Where: set to 1 only in the nightly CI job.
# Read by: src/test/truthfulness.test.ts (added in I10)
RUN_AI_TESTS=0
